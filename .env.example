# Copier ce fichier en .env puis renseigner les valeurs.
#   cp .env.example .env

# --- Secrets locaux (générer ex. : openssl rand -hex 32) ---------------------
POSTGRES_PASSWORD=change-me-postgres
JWT_SECRET=change-me-jwt-secret-openssl-rand-hex-32

# --- Clé maître LiteLLM (reprendre celle de ~/qwen_3.8_vnimanieAI/.env) ------
# Le service appelle la passerelle existante via l'alias "IA".
LITELLM_MASTER_KEY=sk-...
LITELLM_MODEL=IA

# --- API vue par le navigateur (même origine via Traefik, pas de CORS) -------
NEXT_PUBLIC_API_BASE=/api

# --- Repli recherche (optionnel) ---------------------------------------------
# Utilisés UNIQUEMENT quand SearXNG ne renvoie rien (rate-limité). Ordre :
# NewsAPI -> GNews -> Serper. Laisser vide = client désactivé.
# NewsAPI (https://newsapi.org) : ~100 req/jour gratuites (articles différés ~24h).
NEWSAPI_API_KEY=
# GNews (https://gnews.io) : ~100 req/jour gratuites, 10 articles max/requête.
GNEWS_API_KEY=
# Serper.dev (https://serper.dev) : 2500 req gratuites. Actuellement HS.
SERPER_API_KEY=
